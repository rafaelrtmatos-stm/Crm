  "firestore": {
    "companies": { "schema": "Company", "description": "Empresas cadastradas" },
    "modules": { "schema": "Module", "description": "Configuração de módulos" },
    "users": { "schema": "AppUser", "description": "Usuários do sistema" },
    "channel_accounts": { "schema": "ChannelAccount", "description": "Integrações externas" },
    "leads": { "schema": "Lead", "description": "Funil de leads" },
    "contacts": { "schema": "Contact", "description": "Base de contatos" },
    "funnels": { "schema": "Funnel", "description": "Estrutura de funis" },
    "funnel_stages": { "schema": "FunnelStage", "description": "Etapas dos funis" },
    "conversations": { "schema": "Conversation", "description": "Chats unificados" },
    "messages": { "schema": "Message", "description": "Mensagens individuais" },
    "tasks": { "schema": "Task", "description": "Gestão de tarefas" },
    "meta_accounts": { "schema": "MetaAdAccount", "description": "Contas de anúncios Meta" },
    "meta_campaigns": { "schema": "MetaCampaign", "description": "Campanhas Meta" },
    "meta_adsets": { "schema": "MetaAdSet", "description": "Conjuntos de anúncios Meta" },
    "meta_ads": { "schema": "MetaAd", "description": "Anúncios Meta" },
    "real_estate_enterprises": { "schema": "RealEstateEnterprise", "description": "Loteamentos" },
    "lots": { "schema": "Lot", "description": "Unidades/Lotes" },
    "real_estate_sales": { "schema": "RealEstateSale", "description": "Vendas realizadas" },
    "real_estate_installments": { "schema": "RealEstateInstallment", "description": "Financeiro de vendas" },
    "inventory_items": { "schema": "InventoryItem", "description": "Catálogo de produtos" },
    "pos_sales": { "schema": "POSSale", "description": "Vendas de caixa" },
    "printing_services": { "schema": "PrintingService", "description": "Produção gráfica" },
    "payments": { "schema": "Payment", "description": "Transações financeiras" },
    "automation_flows": { "schema": "AutomationFlow", "description": "Chatbots e bots" },
    "logs": { "schema": "Log", "description": "Histórico de ações" },
    "settings": { "schema": "Setting", "description": "Configurações por empresa" },
    "notifications": { "schema": "object", "description": "Alertas de usuários" }
