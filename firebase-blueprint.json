      "title": "Caixa PDV",
      "description": "Controle de abertura e fechamento de caixa",
      "type": "object",
      "properties": {
        "companyId": { "type": "string" },
        "operatorId": { "type": "string" },
        "openedAt": { "type": "string" },
        "closedAt": { "type": "string" },
        "openingBalance": { "type": "number" },
        "expectedBalance": { "type": "number" },
        "actualBalance": { "type": "number" },
        "difference": { "type": "number" },
        "isOpen": { "type": "boolean" }
      }
    },
    "AutomationFlow": {
      "title": "Automação",
      "description": "Fluxos automáticos",
      "type": "object",
      "properties": {
        "companyId": { "type": "string" },
        "name": { "type": "string" },
        "isActive": { "type": "boolean" }
      }
    },
    "Log": {
      "title": "Log",
      "description": "Auditoria do sistema",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "action": { "type": "string" },
        "timestamp": { "type": "string" }
      }
    }
