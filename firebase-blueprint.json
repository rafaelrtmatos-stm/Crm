    "RealEstateInstallment": {
      "title": "Parcela",
      "description": "Parcelas de financiamento",
      "type": "object",
      "properties": {
        "saleId": { "type": "string" },
        "dueDate": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string" }
      }
    },
    "InventoryItem": {
      "title": "Item de Estoque",
      "description": "Produtos e insumos",
      "type": "object",
      "properties": {
        "companyId": { "type": "string" },
        "name": { "type": "string" },
        "stock": { "type": "number" },
        "price": { "type": "number" }
      }
    },
    "POSSale": {
      "title": "Venda PDV",
      "description": "Vendas de balcão",
      "type": "object",
      "properties": {
        "companyId": { "type": "string" },
        "total": { "type": "number" },
        "items": { "type": "array" }
      }
    },
    "PrintingService": {
      "title": "Serviço",
      "description": "Pedidos de produção gráfica",
      "type": "object",
      "properties": {
        "companyId": { "type": "string" },
        "status": { "type": "string" },
        "value": { "type": "number" }
      }
    },
    "Payment": {
      "title": "Pagamento",
      "description": "Recebimentos financeiros",
      "type": "object",
      "properties": {
        "companyId": { "type": "string" },
        "amount": { "type": "number" },
        "method": { "type": "string" },
        "status": { "type": "string" }
      }
    },
