{
  "entities": {
    "Company": {
      "title": "Empresa",
      "description": "Cadastro de empresas do sistema",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "shortName": { "type": "string" },
        "slug": { "type": "string" },
        "cnpj": { "type": "string" },
        "logoUrl": { "type": "string" },
        "primaryColor": { "type": "string" },
        "secondaryColor": { "type": "string" },
        "address": { "type": "object" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "isActive": { "type": "boolean" },
        "activeModules": { "type": "array" }
      },
      "required": ["name", "slug"]
    },
    "Module": {
      "title": "Módulo",
      "description": "Módulos disponíveis no sistema",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "name": { "type": "string" },
        "menuOrder": { "type": "number" },
        "isActive": { "type": "boolean" }
      }
    },
    "AppUser": {
      "title": "Usuário",
      "description": "Cadastro de usuários",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "isAdmin": { "type": "boolean" },
        "isActive": { "type": "boolean" },
        "allowedCompanies": { "type": "array" }
      }
    },
    "ChannelAccount": {
      "title": "Conta de Canal",
      "description": "Contas conectadas (WhatsApp, Meta, etc.)",
      "type": "object",
      "properties": {
        "companyId": { "type": "string" },
        "channelType": { "type": "string" },
        "accountName": { "type": "string" },
        "status": { "type": "string" },
        "isActive": { "type": "boolean" }
      }
    },
    "Lead": {
      "title": "Lead",
      "description": "Captação e atendimento comercial",
      "type": "object",
      "properties": {
        "companyId": { "type": "string" },
        "fullName": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "status": { "type": "string" },
        "funnelId": { "type": "string" },
        "stageId": { "type": "string" },
        "responsibleId": { "type": "string" },
        "tracking": { "type": "object" },
        "waitingSince": { "type": "string" },
        "lastInteractionAt": { "type": "string" }
      }
    },
    "Contact": {
      "title": "Contato",
      "description": "Contatos consolidados",
      "type": "object",
      "properties": {
        "companyId": { "type": "string" },
        "fullName": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" }
      }
    },
    "Funnel": {
      "title": "Funil",
      "description": "Funis de vendas",
      "type": "object",
      "properties": {
        "companyId": { "type": "string" },
        "name": { "type": "string" },
        "isActive": { "type": "boolean" }
      }
    },
    "FunnelStage": {
      "title": "Etapa do Funil",
      "description": "Etapas de um funil",
      "type": "object",
      "properties": {
        "funnelId": { "type": "string" },
        "name": { "type": "string" },
        "order": { "type": "number" },
        "slaMinutes": { "type": "number" }
      }
    },
    "Conversation": {
      "title": "Conversa",
      "description": "Central de mensagens",
      "type": "object",
      "properties": {
        "companyId": { "type": "string" },
        "leadId": { "type": "string" },
        "channelId": { "type": "string" },
        "status": { "type": "string" },
        "waitingSince": { "type": "string" },
        "slaStatus": { "type": "string" },
        "priority": { "type": "string" },
        "lastMessageAt": { "type": "string" },
        "lastMessageText": { "type": "string" }
      }
    },
    "Setting": {
      "title": "Configuração",
      "description": "Configurações gerais por empresa",
      "type": "object",
      "properties": {
        "companyId": { "type": "string" },
        "defaultFunnelId": { "type": "string" },
        "incomingMessagesFunnelId": { "type": "string" },
        "logoUrl": { "type": "string" }
      }
    },
    "Message": {
      "title": "Mensagem",
      "description": "Conteúdo das conversas",
      "type": "object",
      "properties": {
        "conversationId": { "type": "string" },
        "senderType": { "type": "string" },
        "text": { "type": "string" },
        "mediaUrl": { "type": "string" }
      }
    },
    "Task": {
      "title": "Tarefa",
      "description": "Gestão de afazeres",
      "type": "object",
      "properties": {
        "companyId": { "type": "string" },
        "title": { "type": "string" },
        "dueDate": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "MetaAdAccount": {
      "title": "Conta de Anúncio Meta",
      "description": "Contas de anúncios integradas",
      "type": "object",
      "properties": {
        "companyId": { "type": "string" },
        "fbAccountId": { "type": "string" },
        "name": { "type": "string" },
        "currency": { "type": "string" },
        "timezone": { "type": "string" },
        "accountStatus": { "type": "string" },
        "spendToday": { "type": "number" },
        "spendWeek": { "type": "number" },
        "spendMonth": { "type": "number" }
      }
    },
    "MetaCampaign": {
      "title": "Campanha Meta",
      "description": "Campanhas de anúncios",
      "type": "object",
      "properties": {
        "companyId": { "type": "string" },
        "accountId": { "type": "string" },
        "fbCampaignId": { "type": "string" },
        "name": { "type": "string" },
        "objective": { "type": "string" },
        "status": { "type": "string" },
        "budget": { "type": "number" },
        "budgetType": { "type": "string" },
        "results": { "type": "number" },
        "costPerResult": { "type": "number" },
        "reach": { "type": "number" },
        "impressions": { "type": "number" },
        "spend": { "type": "number" }
      }
    },
    "MetaAdSet": {
      "title": "Conjunto de Anúncios Meta",
      "description": "Segmentação e orçamento",
      "type": "object",
      "properties": {
        "campaignId": { "type": "string" },
        "fbAdSetId": { "type": "string" },
        "name": { "type": "string" },
        "status": { "type": "string" },
        "dailyBudget": { "type": "number" },
        "lifetimeBudget": { "type": "number" },
        "optimizationGoal": { "type": "string" }
      }
    },
    "MetaAd": {
      "title": "Anúncio Meta",
      "description": "Criativos e resultados individuais",
      "type": "object",
      "properties": {
        "adSetId": { "type": "string" },
        "fbAdId": { "type": "string" },
        "name": { "type": "string" },
        "status": { "type": "string" },
        "spend": { "type": "number" },
        "results": { "type": "number" }
      }
    },
    "RealEstateEnterprise": {
      "title": "Empreendimento",
      "description": "Loteamentos e prédios",
      "type": "object",
      "properties": {
        "companyId": { "type": "string" },
        "name": { "type": "string" },
        "location": { "type": "string" }
      }
    },
