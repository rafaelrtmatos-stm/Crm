rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // Collection: companies (id, name, shortName, slug, isActive, ...)
    // Collection: users (id, name, role, companies[], isAdmin, ...)
    // Collection: leads (id, companyId, fullName, status, sourceType, ...)
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        (request.auth.token.email == "rafaelrtmatos@gmail.com" && request.auth.token.email_verified == true)
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasCompanyAccess(companyId) {
      let user = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isAuthenticated() && (
        user.role == 'admin' ||
        (user.companies != null && companyId in user.companies)
      );
    }

    function fieldUnchanged(field) {
      return !(field in request.resource.data) || request.resource.data[field] == resource.data[field];
    }

    function isValidString(field, min, max) {
      return request.resource.data[field] is string && 
             request.resource.data[field].size() >= min && 
             request.resource.data[field].size() <= max;
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================
    
    function isValidLead(data) {
      return data.fullName is string && data.fullName.size() > 0 && data.fullName.size() < 100 &&
             data.companyId is string &&
             (!('status' in data) || data.status is string) &&
             (!('estimatedValue' in data) || data.estimatedValue is number);
    }

    function isValidMessage(data) {
      return data.conversationId is string &&
             (!('text' in data) || (data.text is string && data.text.size() < 5000)) &&
             data.senderType in ['customer', 'agent', 'system', 'bot'];
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isAdmin();
    }

    match /companies/{companyId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /leads/{leadId} {
      allow read: if hasCompanyAccess(resource.data.companyId);
      allow create: if hasCompanyAccess(request.resource.data.companyId) && isValidLead(request.resource.data);
      allow update: if hasCompanyAccess(resource.data.companyId) && 
                      isValidLead(request.resource.data) &&
                      fieldUnchanged('companyId') &&
                      fieldUnchanged('createdAt');
      allow delete: if isAdmin();
    }

    match /messages/{msgId} {
      allow read: if hasCompanyAccess(resource.data.companyId);
      allow create: if hasCompanyAccess(request.resource.data.companyId) && isValidMessage(request.resource.data);
      allow update: if false; // Messages are usually immutable
      allow delete: if isAdmin();
    }

    // Generic Company-Scoped Entities
    match /{collectionName}/{docId} {
      function isScoped() {
        return collectionName in [
          'contacts', 'funnels', 'funnel_stages', 'conversations', 'tasks',
          'real_estate_enterprises', 'lots', 'real_estate_sales', 'printing_services',
          'pos_sales', 'inventory_items', 'payments', 'settings'
        ];
      }
      allow read: if isScoped() && hasCompanyAccess(resource.data.companyId);
      allow create: if isScoped() && hasCompanyAccess(request.resource.data.companyId);
      allow update: if isScoped() && hasCompanyAccess(resource.data.companyId) && fieldUnchanged('companyId');
      allow delete: if isAdmin();
    }

    match /logs/{logId} {
      allow read, create: if isAdmin();
    }

    match /notifications/{notifId} {
      allow read, update: if isOwner(resource.data.userId);
      allow delete: if isOwner(resource.data.userId);
    }
  }
}
