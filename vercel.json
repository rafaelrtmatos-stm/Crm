{
  "rewrites": [
    {
      "source": "/assinar/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|WhatsApp|Twitterbot|TelegramBot|LinkedInBot|Slackbot|Discordbot|SkypeUriPreview|Pinterest|vkShare|W3C_Validator).*"
        }
      ],
      "missing": [
        { "type": "query", "key": "direct" }
      ],
      "destination": "/api/assinar/:id"
    },
    { "source": "/api/whatsapp-webhook/:evento", "destination": "/api/whatsapp-webhook" },
    { "source": "/api/transcrever-audio", "destination": "/api/transcrever?rota=audio" },
    { "source": "/api/transcrever-pendentes", "destination": "/api/transcrever?rota=pendentes" },
    { "source": "/api/whatsapp-foto-perfil", "destination": "/api/whatsapp-contato?rota=foto-perfil" },
    { "source": "/api/whatsapp-presence-subscribe", "destination": "/api/whatsapp-contato?rota=presence-subscribe" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
