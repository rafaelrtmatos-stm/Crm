# Copie este arquivo para .env (dentro da pasta functions/) e preencha.
#
# META_WEBHOOK_VERIFY_TOKEN: uma senha que VOCÊ inventa (qualquer texto,
# ex: "rpro-2026-verify-xyz"). É usada só uma vez, no momento em que você
# cola a URL do webhook no painel da Meta — ela pede pra você digitar o
# mesmo valor nos dois lugares (painel da Meta + esta variável) só pra
# confirmar que o webhook é seu.
META_WEBHOOK_VERIFY_TOKEN=
